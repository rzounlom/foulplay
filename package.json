{
  "name": "foulplay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_PRIVATE_SKIP_TURBO=1 next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "db:seed": "tsx prisma/seed.ts",
    "db:fix-card-descriptions": "tsx scripts/fix-card-descriptions.ts",
    "db:migrate-hand-size": "tsx scripts/apply-hand-size-migration.ts",
    "dev:e2e": "APP_ENV=test tsx scripts/e2e-dev.ts",
    "e2e:db:reset": "APP_ENV=test tsx scripts/e2e-db-reset.ts",
    "e2e:auth:setup": "APP_ENV=test tsx scripts/e2e-auth-setup.ts",
    "test:e2e": "APP_ENV=test playwright test --project=setup --project=e2e",
    "test:e2e:headed": "APP_ENV=test playwright test --project=setup --project=e2e --headed",
    "test:e2e:ui": "APP_ENV=test playwright test --ui",
    "test:e2e:debug": "APP_ENV=test playwright test --project=setup --project=e2e --debug",
    "test:e2e:ci": "APP_ENV=test tsx scripts/e2e-ci.ts",
    "test:e2e:stripe": "APP_ENV=test RUN_STRIPE_E2E=true playwright test --project=setup --project=stripe",
    "test:load": "APP_ENV=test artillery run tests/load/public-smoke.yml",
    "test:load:matchmaking": "APP_ENV=test artillery run tests/load/matchmaking.yml",
    "test:load:gameplay": "APP_ENV=test artillery run tests/load/gameplay.yml",
    "check-env": "tsx scripts/check-env.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.37.1",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@types/pg": "^8.16.0",
    "@upstash/qstash": "^2.9.0",
    "ably": "^2.17.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "pg": "^8.18.0",
    "prisma": "^7.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "stripe": "^22.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jest/test-sequencer": "^30.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "artillery": "^2.0.34",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "undici": "^6.19.8"
  }
}
